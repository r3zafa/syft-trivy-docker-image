# Docker Compose Environment Variables
# Copy this file to .env and customize for your project

# Project identifier (used for container naming)
PROJECT_NAME=my-project

# Path to the project to scan
# Can be absolute or relative path
PROJECT_PATH=/path/to/your/project

# Output directory for generated SBOMs
# All SBOM files will be saved here
OUTPUT_DIR=./sbom-output

# Optional: Docker image to scan (if not scanning local project)
# Default: nginx:latest
# Example: python:3.11, ubuntu:22.04, etc
TARGET_IMAGE=nginx:latest
